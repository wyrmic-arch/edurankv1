# ── Frontend (apps/web) ─────────────────────────────────────────────
# Set in apps/web/.env.local for local dev, or Pages env vars in prod.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# ── API worker (apps/api) ───────────────────────────────────────────
# For local dev put these in apps/api/.dev.vars (gitignored).
# For production use `wrangler secret put` / wrangler.toml [vars].

# Optional. Without it, the image pipeline serves designed SVG placeholders.
# Get one at https://unsplash.com/developers (Demo key is fine).
UNSPLASH_ACCESS_KEY=

# Comma-separated origin allowlist for CORS. "*" allows all (not recommended in prod).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Only needed if you seed a remote environment through the public API.
DEV_SEED_SECRET=
