{
  "name": "edurank",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "migrate": "npm run migrate:local -w apps/api",
    "seed": "npm run seed -w apps/api",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.15.18": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.17.19": true,
    "workerd@1.20260831.1": true,
    "workerd@1.20250718.0": true,
    "sharp@0.35.2": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  }
}
