# Optional. Without it, the image pipeline serves designed SVG placeholders.
UNSPLASH_ACCESS_KEY=

# Comma-separated origin allowlist for local dev CORS. Must match what the
# web app is served from.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local-only seed script secret. Never set this in prod.
DEV_SEED_SECRET=local-dev-seed

# Optional. Signs note ownership certificates (HMAC-SHA256). Generate a random
# value in prod. Without it, certificates render but are marked "unsigned".
CERT_SECRET=

# Optional. Replies to app emails and operational alerts are routed here.
REPLY_TO=
ALERT_EMAIL=

# Dev only: auto-verify new accounts so local seed/smoke skip the inbox step.
# NEVER set this in production.
DEV_AUTO_VERIFY=true

# Shared secret for publishing official notes (scripts/publish-official.mjs).
# Generate a random value; set the same value as a Worker secret in prod.
OFFICIAL_PUBLISH_SECRET=
